{
  "name": "coco-objects",
  "version": "0.1.0",
  "protocol": 2,
  "effect": "pure",
  "command": [
    "../../dist/cargo/release/videoplugins-coco-objects"
  ],
  "timeoutSeconds": 1800,
  "stallSeconds": 120,
  "concurrency": 1,
  "requirements": {
    "cpu": 2,
    "memoryMb": 800
  },
  "permissions": {
    "env": [
      "VIDEOCRAW_MODELS"
    ],
    "network": [
      "github.com",
      "release-assets.githubusercontent.com"
    ],
    "write": [
      "~/.videocraw/models"
    ]
  },
  "actions": {
    "find": {
      "description": "Finds the things a video shows, from the 80 classes of the COCO set (person, cat, dog, car...), with a detector and no language model. Each time a class shows up it gives one appearance with the first picture it is in and the time; a class that stays on screen is reported once, when it first shows.",
      "wants": {
        "media": {
          "media": "video",
          "format": "rgb24",
          "width": 640,
          "everyMs": 500
        }
      },
      "inputs": {
        "type": "object",
        "properties": {
          "media": {
            "type": [
              "object",
              "string"
            ],
            "description": "The video: a stored file or a video as media.open gives it, or a path in text. VideoCraw decodes a colour picture of it every half second."
          },
          "classes": {
            "type": "array",
            "description": "What to look for. Leave it out to look for every class.",
            "items": {
              "type": "string",
              "enum": [
                "person",
                "bicycle",
                "car",
                "motorcycle",
                "airplane",
                "bus",
                "train",
                "truck",
                "boat",
                "traffic light",
                "fire hydrant",
                "stop sign",
                "parking meter",
                "bench",
                "bird",
                "cat",
                "dog",
                "horse",
                "sheep",
                "cow",
                "elephant",
                "bear",
                "zebra",
                "giraffe",
                "backpack",
                "umbrella",
                "handbag",
                "tie",
                "suitcase",
                "frisbee",
                "skis",
                "snowboard",
                "sports ball",
                "kite",
                "baseball bat",
                "baseball glove",
                "skateboard",
                "surfboard",
                "tennis racket",
                "bottle",
                "wine glass",
                "cup",
                "fork",
                "knife",
                "spoon",
                "bowl",
                "banana",
                "apple",
                "sandwich",
                "orange",
                "broccoli",
                "carrot",
                "hot dog",
                "pizza",
                "donut",
                "cake",
                "chair",
                "couch",
                "potted plant",
                "bed",
                "dining table",
                "toilet",
                "tv",
                "laptop",
                "mouse",
                "remote",
                "keyboard",
                "cell phone",
                "microwave",
                "oven",
                "toaster",
                "sink",
                "refrigerator",
                "book",
                "clock",
                "vase",
                "scissors",
                "teddy bear",
                "hair drier",
                "toothbrush"
              ]
            }
          },
          "model": {
            "type": "string",
            "enum": [
              "nano",
              "tiny",
              "s"
            ],
            "description": "The detector: nano is the fastest, s the most accurate (default nano). Downloaded once, on first use."
          },
          "minConfidence": {
            "type": "number",
            "minimum": 0.05,
            "maximum": 1,
            "description": "How sure the detector must be of a thing (default 0.5)."
          },
          "gapMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 600000,
            "description": "How long a class can be out of the pictures before it counts as gone; if it comes back that is another appearance (default 2000)."
          },
          "minSamples": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "In how few pictures a thing is still reported, so a flicker is not (default 2, which is a second)."
          }
        },
        "required": [
          "media"
        ],
        "additionalProperties": false
      },
      "outputs": {
        "type": "object",
        "properties": {
          "appearances": {
            "type": "array",
            "description": "In the order they start.",
            "items": {
              "type": "object",
              "properties": {
                "class": {
                  "type": "string",
                  "enum": [
                    "person",
                    "bicycle",
                    "car",
                    "motorcycle",
                    "airplane",
                    "bus",
                    "train",
                    "truck",
                    "boat",
                    "traffic light",
                    "fire hydrant",
                    "stop sign",
                    "parking meter",
                    "bench",
                    "bird",
                    "cat",
                    "dog",
                    "horse",
                    "sheep",
                    "cow",
                    "elephant",
                    "bear",
                    "zebra",
                    "giraffe",
                    "backpack",
                    "umbrella",
                    "handbag",
                    "tie",
                    "suitcase",
                    "frisbee",
                    "skis",
                    "snowboard",
                    "sports ball",
                    "kite",
                    "baseball bat",
                    "baseball glove",
                    "skateboard",
                    "surfboard",
                    "tennis racket",
                    "bottle",
                    "wine glass",
                    "cup",
                    "fork",
                    "knife",
                    "spoon",
                    "bowl",
                    "banana",
                    "apple",
                    "sandwich",
                    "orange",
                    "broccoli",
                    "carrot",
                    "hot dog",
                    "pizza",
                    "donut",
                    "cake",
                    "chair",
                    "couch",
                    "potted plant",
                    "bed",
                    "dining table",
                    "toilet",
                    "tv",
                    "laptop",
                    "mouse",
                    "remote",
                    "keyboard",
                    "cell phone",
                    "microwave",
                    "oven",
                    "toaster",
                    "sink",
                    "refrigerator",
                    "book",
                    "clock",
                    "vase",
                    "scissors",
                    "teddy bear",
                    "hair drier",
                    "toothbrush"
                  ]
                },
                "startMs": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "When the picture where it first shows is shown, in the time of the video."
                },
                "endMs": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "When the last picture it is in stops being shown."
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "The surest the detector was of it in any picture of the appearance."
                },
                "peakCount": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "The most of this class seen together in one picture."
                },
                "samples": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "In how many pictures it was seen."
                },
                "picture": {
                  "type": "object",
                  "description": "The first picture of the appearance with the boxes of the class drawn on it: a stored PNG.",
                  "properties": {
                    "blob": {
                      "type": "string"
                    },
                    "mime": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "blob",
                    "mime",
                    "path",
                    "bytes"
                  ]
                }
              },
              "required": [
                "class",
                "startMs",
                "endMs",
                "confidence",
                "peakCount",
                "samples",
                "picture"
              ]
            }
          },
          "samples": {
            "type": "integer",
            "minimum": 0,
            "description": "How many pictures were looked at."
          },
          "model": {
            "type": "string"
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "appearances",
          "samples",
          "model",
          "durationMs"
        ]
      },
      "failures": [
        {
          "code": 400,
          "description": "A param is wrong, or media is missing or not a video VideoCraw decoded for the plugin."
        },
        {
          "code": 404,
          "description": "A file is not there."
        },
        {
          "code": 422,
          "description": "The video has no picture, a file cannot be read, or the model cannot be loaded."
        },
        {
          "code": 503,
          "description": "The model could not be downloaded (it is fetched once, on first use). Trying again may work."
        },
        {
          "code": "CANCELLED",
          "description": "The call was cancelled."
        }
      ]
    }
  }
}
