{
  "name": "sound-events",
  "version": "0.1.0",
  "title": "Find sounds",
  "description": "Finds the sounds a video has from the 521 classes of AudioSet (speech, music, meow, bark, siren...) with a small tagger and no language model.",
  "protocol": 2,
  "effect": "pure",
  "command": [
    "../../dist/cargo/release/videoplugins-sound-events"
  ],
  "timeoutSeconds": 1800,
  "stallSeconds": 120,
  "concurrency": 1,
  "requirements": {
    "cpu": 2,
    "memoryMb": 600
  },
  "permissions": {
    "env": [
      "VIDEOCRAW_MODELS"
    ],
    "network": [
      "huggingface.co",
      "us.aws.cdn.hf.co"
    ],
    "write": [
      "~/.videocraw/models"
    ]
  },
  "actions": {
    "find": {
      "description": "Finds the sounds a video has, from the 521 classes of AudioSet (speech, music, cat, meow, dog, bark, siren, door...), with a small neural tagger and no language model. Each time a sound is heard it gives one event with its start and end and a clip of it; a sound that goes on is one event.",
      "title": "Find sounds",
      "category": "find",
      "icon": "sound",
      "wants": {
        "media": {
          "media": "audio",
          "sampleRate": 16000,
          "channels": 1
        }
      },
