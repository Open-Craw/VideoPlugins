            "x-ui": {
              "group": "everyday",
              "widget": "chips"
            }
          },
          "minConfidence": {
            "title": "Least confidence",
            "type": "number",
            "minimum": 0.05,
            "maximum": 1,
            "description": "How sure the tagger must be of a sound (default 0.5).",
            "default": 0.5,
            "x-ui": {
              "group": "everyday",
              "widget": "slider"
            }
          },
          "gapMs": {
            "title": "Longest gap",
            "type": "integer",
            "minimum": 0,
            "maximum": 600000,
            "description": "How long a sound can stop before it counts as gone; if it comes back that is another event (default 1000).",
            "default": 1000,
            "x-ui": {
              "group": "advanced",
              "unit": "ms"
            }
          },
          "minFrames": {
            "title": "Fewest frames",
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "In how few frames (about half a second apart) a sound is still reported (default 1).",
            "default": 1,
            "x-ui": {
              "group": "advanced"
            }
          },
          "clips": {
            "title": "Make a clip of each event",
            "type": "boolean",
            "description": "Give a clip of each event (default true).",
            "default": true,
            "x-ui": {
              "group": "advanced"
            }
          },
          "clipPadMs": {
            "title": "Sound around each event",
            "type": "integer",
            "minimum": 0,
            "maximum": 5000,
            "description": "How much sound before and after an event goes in its clip (default 250).",
            "default": 250,
            "x-ui": {
              "group": "advanced",
              "unit": "ms"
            }
          },
          "maxClipMs": {
            "title": "Longest clip",
            "type": "integer",
            "minimum": 1000,
            "maximum": 60000,
            "description": "The longest a clip can be; a longer event is cut short from its start (default 10000).",
            "default": 10000,
            "x-ui": {
              "group": "advanced",
              "unit": "ms"
            }
          },
          "device": {
            "title": "Run on",
            "type": "string",
            "enum": [
              "auto",
              "cpu",
              "gpu"
            ],
            "default": "cpu",
            "description": "Where the tagger runs: cpu (the default) or gpu / auto, which use the graphics card (on Windows, any DirectX 12 card). The card was no faster here (this model is small and the sound is scored in chunks), so the processor is the default; the scores are the same on both. A card that cannot be used falls back to the processor; the result says what ran.",
            "x-ui": {
              "group": "advanced",
              "enumTitles": {
                "auto": "Automatic",
                "cpu": "Processor",
                "gpu": "Graphics card"
              }
            }
          }
