{
  "name": "sound-volume",
  "version": "0.1.0",
  "protocol": 2,
  "effect": "pure",
  "command": ["../../dist/cargo/release/videoplugins-sound-volume"],
  "timeoutSeconds": 300,
  "concurrency": 4,
  "actions": {
    "map": {
      "description": "How loud the sound is over time: level and peak per window, and the level of the low, mid and high bands.",
      "wants": { "audio": { "media": "audio", "sampleRate": 44100, "channels": 1 } },
      "inputs": {
        "type": "object",
        "properties": {
          "audio": { "type": ["object", "string"], "description": "The sound: a stored file (an object with an absolute file path) or a path in text." },
          "windowMs": { "type": "integer", "minimum": 10, "maximum": 60000, "description": "How long each window is (default 1000)." },
          "sampleRate": { "type": "integer", "minimum": 4000, "maximum": 192000, "description": "The rate to listen at; the highest frequency that can be told is half of it. Default: the sound's own." },
          "bands": { "type": "boolean", "description": "Split each window into low, mid and high (default true)." },
          "lowMidHz": { "type": "number", "minimum": 1, "description": "Below this is low (default 250)." },
          "midHighHz": { "type": "number", "minimum": 1, "description": "From this up is high (default 4000)." }
        },
        "required": ["audio"],
        "additionalProperties": false
      },
      "outputs": {
        "type": "object",
        "properties": {
          "sampleRate": { "type": "integer" },
          "durationMs": { "type": "integer" },
          "windowMs": { "type": "integer" },
          "bandsHz": { "type": ["object", "null"], "properties": { "lowBelow": { "type": "number" }, "highFrom": { "type": "number" } } },
          "windows": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "startMs": { "type": "integer" },
                "endMs": { "type": "integer" },
                "rmsDb": { "type": "number", "description": "How loud it sounds on average, in dB relative to full scale (0 is the loudest, -100 is silence)." },
                "peakDb": { "type": "number", "description": "The loudest single instant, in dB." },
                "bands": {
                  "type": "object",
                  "properties": { "low": { "type": "number" }, "mid": { "type": "number" }, "high": { "type": "number" } }
                }
              },
              "required": ["startMs", "endMs", "rmsDb", "peakDb"]
            }
          },
          "summary": {
            "type": "object",
            "properties": {
              "averageRmsDb": { "type": "number" },
              "peakDb": { "type": "number" },
              "loudest": { "type": ["object", "null"], "properties": { "startMs": { "type": "integer" }, "endMs": { "type": "integer" }, "rmsDb": { "type": "number" } } },
              "quietest": { "type": ["object", "null"], "properties": { "startMs": { "type": "integer" }, "endMs": { "type": "integer" }, "rmsDb": { "type": "number" } } }
            }
          }
        },
        "required": ["sampleRate", "durationMs", "windowMs", "windows", "summary"]
      },
      "failures": [
        { "code": 400, "description": "A param is wrong or audio is missing." },
        { "code": 404, "description": "The sound file is not there." },
        { "code": 422, "description": "The file is not a sound this plugin can read." }
      ]
    },
    "silences": {
      "description": "The stretches where the sound stays below a level for at least a time.",
      "wants": { "audio": { "media": "audio", "sampleRate": 44100, "channels": 1 } },
      "inputs": {
        "type": "object",
        "properties": {
          "audio": { "type": ["object", "string"] },
          "thresholdDb": { "type": "number", "minimum": -100, "maximum": 0, "description": "Quieter than this is silence (default -50)." },
          "minMs": { "type": "integer", "minimum": 0, "description": "Shorter stretches are ignored (default 500)." },
          "windowMs": { "type": "integer", "minimum": 10, "maximum": 10000, "description": "How finely the sound is looked at (default 100)." },
          "sampleRate": { "type": "integer", "minimum": 4000, "maximum": 192000 }
        },
        "required": ["audio"],
        "additionalProperties": false
      },
      "outputs": {
        "type": "object",
        "properties": {
          "durationMs": { "type": "integer" },
          "thresholdDb": { "type": "number" },
          "minMs": { "type": "integer" },
          "silences": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "startMs": { "type": "integer" }, "endMs": { "type": "integer" }, "durationMs": { "type": "integer" } },
              "required": ["startMs", "endMs", "durationMs"]
            }
          },
          "totalSilenceMs": { "type": "integer" }
        },
        "required": ["silences", "totalSilenceMs"]
      },
      "failures": [
        { "code": 400, "description": "A param is wrong or audio is missing." },
        { "code": 404, "description": "The sound file is not there." },
        { "code": 422, "description": "The file is not a sound this plugin can read." }
      ]
    }
  }
}
